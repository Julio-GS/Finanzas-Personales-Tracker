# Single-user Authentication Credentials (server-only)
AUTH_USERNAME=admin
AUTH_PASSWORD=replace-with-secure-password
AUTH_SECRET=replace-with-min-32-char-secret-key-at-least-32-bytes
AUTH_SESSION_MAX_AGE_SECONDS=604800

# Neon Serverless PostgreSQL Database URLs
# DATABASE_URL: Pooled connection string (-pooler) for web application traffic
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED: Direct unpooled connection string for migrations (Drizzle Kit)
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-sample.us-east-2.neon.tech/neondb?sslmode=require

# Google Gemini API Configuration (server-only)
GEMINI_API_KEY=replace-with-google-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
